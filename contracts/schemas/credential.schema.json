{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parampara.app/schemas/credential.schema.json",
  "title": "ProofOfSkillCredential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@context",
    "id",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject",
    "proof"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "prefixItems": [
        {
          "const": "https://www.w3.org/ns/credentials/v2"
        },
        {
          "type": "string"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "id": {
      "type": "string"
    },
    "type": {
      "type": "array",
      "prefixItems": [
        {
          "const": "VerifiableCredential"
        },
        {
          "const": "ProofOfSkillCredential"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "credentialSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "skill",
        "master",
        "performance",
        "evidence",
        "policy",
        "cosigned_by",
        "org"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "title",
            "domain"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 0
            },
            "title": {
              "$ref": "skill-graph.schema.json#/$defs/LocalizedText"
            },
            "domain": {
              "type": "string"
            }
          }
        },
        "master": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "lineage"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "lineage": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clean_runs",
            "sessions",
            "mastery_min",
            "mode_of_final_run",
            "errors_in_final_run"
          ],
          "properties": {
            "clean_runs": {
              "type": "integer",
              "minimum": 0
            },
            "sessions": {
              "type": "integer",
              "minimum": 0
            },
            "mastery_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mode_of_final_run": {
              "type": "string"
            },
            "errors_in_final_run": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "merkle_root",
            "item_count",
            "algorithm"
          ],
          "properties": {
            "merkle_root": {
              "type": "string"
            },
            "item_count": {
              "type": "integer",
              "minimum": 0
            },
            "algorithm": {
              "const": "sha256-merkle-v1"
            }
          }
        },
        "policy": {
          "$ref": "skill-graph.schema.json#/$defs/CredentialPolicy"
        },
        "cosigned_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "role"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "role": {
              "const": "supervisor"
            }
          }
        },
        "org": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "city"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "city": {
              "type": "string"
            }
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cryptosuite",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "properties": {
        "type": {
          "const": "DataIntegrityProof"
        },
        "cryptosuite": {
          "const": "eddsa-jcs-2022"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "verificationMethod": {
          "type": "string"
        },
        "proofPurpose": {
          "const": "assertionMethod"
        },
        "proofValue": {
          "type": "string"
        }
      }
    }
  }
}
