{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parampara.app/schemas/verifier-verdict.schema.json",
  "title": "VerifierVerdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "confidence",
    "predicate_results",
    "visible_issues",
    "coach_hint_hi",
    "frame_sha256",
    "model",
    "latency_ms"
  ],
  "properties": {
    "status": {
      "enum": [
        "pass",
        "fail",
        "needs_better_view",
        "unavailable"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "predicate_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PredicateResult"
      }
    },
    "visible_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coach_hint_hi": {
      "type": "string"
    },
    "frame_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "PredicateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_id",
        "pass",
        "evidence"
      ],
      "properties": {
        "predicate_id": {
          "type": "string"
        },
        "pass": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string"
        }
      }
    }
  }
}
