# API environment. Copy to services/api/.env. Never commit real values.
APP_ENV=local                      # local | staging | production
PUBLIC_WEB_ORIGIN=https://localhost:3000
DATABASE_URL=                      # Supabase pooled connection string
SUPABASE_URL=                      # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # secret, server only
SUPABASE_JWT_ISSUER=               # https://<ref>.supabase.co/auth/v1
GEMINI_API_KEY=                    # secret, from Google AI Studio (paid tier)
MODEL_LIVE=gemini-3.8-live         # Live coach and interviewer (T-003 verifies)
MODEL_FLASH=gemini-3.5-flash       # segmenter, predicate writer, critic, verifier
MODEL_LITE=gemini-3.5-flash-lite   # SOP writer, translations, refinery text
MODEL_TTS=                         # set by T-003
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ISSUER_DID=did:web:localhost
ISSUER_KEY_ID=key-1
ISSUER_ED25519_SEED_B64=           # 32 random bytes, base64 (generated by scripts/gen_issuer_seed.py)
PAYOUT_PROVIDER=simulated          # razorpayx_test | simulated
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
DEMO_ORG_ID=                       # uuid from seed
MAX_UPLOAD_MB=150
