{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parampara.app/schemas/trace-event.schema.json",
  "title": "TraceEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scope",
    "agent",
    "kind",
    "summary",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "compile_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "dataset_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "agent": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "agent_start",
        "tool_call",
        "tool_result",
        "handoff",
        "verdict",
        "retry",
        "error",
        "agent_end"
      ]
    },
    "summary": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
