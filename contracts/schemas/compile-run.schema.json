{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parampara.app/schemas/compile-run.schema.json",
  "title": "CompileRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "skill_id",
    "source_clip_id",
    "status",
    "revision",
    "draft_graph",
    "lint_issues",
    "critic_issues",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "skill_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_clip_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "awaiting_review",
        "approved",
        "failed"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "draft_graph": {
      "anyOf": [
        {
          "$ref": "skill-graph.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "lint_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "code",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "critic_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "severity",
          "fix"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
